{
  "id": "T89h-md-nested",
  "description": "Markdown 嵌套引用 + 引用内列表 + 任务列表",
  "provider": "openai-completions",
  "model": "mock-model",
  "mode": "print",
  "prompt": "hi",
  "tui": {
    "cols": 100,
    "rows": 40,
    "snapshots": [
      "md"
    ],
    "steps": [
      {
        "action": "waitScreen",
        "contains": "Pi can explain",
        "timeoutMs": 30000
      },
      {
        "action": "waitStable",
        "quietMs": 1200,
        "timeoutMs": 25000
      },
      {
        "action": "type",
        "text": "hi\r"
      },
      {
        "action": "delay",
        "ms": 6000
      },
      {
        "action": "waitStable",
        "quietMs": 1500,
        "timeoutMs": 20000
      },
      {
        "action": "delay",
        "ms": 600
      },
      {
        "action": "snapshot",
        "name": "md"
      },
      {
        "action": "type",
        "text": "\u0004"
      },
      {
        "action": "waitExit",
        "timeoutMs": 20000
      }
    ]
  },
  "responses": [
    {
      "file": "fixtures/sse/openai/md-nested.sse"
    }
  ]
}