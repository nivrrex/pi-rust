{
  "id": "T37-resume-all",
  "description": "P7-7d2：/resume 后按 Tab 切到 All 作用域的会话列表",
  "provider": "openai-completions",
  "model": "mock-model",
  "mode": "print",
  "prompt": "say hi",
  "files": {
    "AGENTS.md": "# 项目规则\n\n- 项目级：改代码前先跑测试。\n"
  },
  "globalFiles": {
    "CLAUDE.md": "# 全局规则\n\n- 全局级：回答用中文。\n"
  },
  "tui": {
    "cols": 100,
    "rows": 30,
    "snapshots": [
      "all-scope"
    ],
    "steps": [
      {
        "action": "waitScreen",
        "contains": "Pi can explain",
        "timeoutMs": 25000
      },
      {
        "action": "type",
        "text": "/resume"
      },
      {
        "action": "waitStable",
        "quietMs": 800,
        "timeoutMs": 15000
      },
      {
        "action": "type",
        "text": "\r"
      },
      {
        "action": "delay",
        "ms": 8000
      },
      {
        "action": "waitStable",
        "quietMs": 1500,
        "timeoutMs": 20000
      },
      {
        "action": "type",
        "text": "\t"
      },
      {
        "action": "delay",
        "ms": 4000
      },
      {
        "action": "waitStable",
        "quietMs": 1500,
        "timeoutMs": 20000
      },
      {
        "action": "snapshot",
        "name": "all-scope"
      },
      {
        "action": "type",
        "text": "\u001b"
      },
      {
        "action": "waitStable",
        "quietMs": 600,
        "timeoutMs": 10000
      },
      {
        "action": "type",
        "text": "\u0004"
      },
      {
        "action": "waitStable",
        "quietMs": 500,
        "timeoutMs": 10000
      }
    ]
  },
  "responses": [
    {
      "file": "fixtures/sse/openai/text-basic.sse"
    }
  ]
