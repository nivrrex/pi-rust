{
  "id": "T23-longreply",
  "description": "P7-6an/F：长流式回复（97KB SSE，用于性能测量）",
  "provider": "openai-completions",
  "model": "mock-model",
  "mode": "print",
  "prompt": "say hi",
  "files": {
    "AGENTS.md": "# 项目规则\n\n- 项目级：改代码前先跑测试。\n"
  },
  "globalFiles": {
    "CLAUDE.md": "# 全局规则\n\n- 全局级：回答用中文。\n"
  },
  "tui": {
    "cols": 100,
    "rows": 30,
    "steps": [
      {
        "action": "waitScreen",
        "contains": "Pi can explain",
        "timeoutMs": 25000
      },
      {
        "action": "type",
        "text": "say hi"
      },
      {
        "action": "waitStable",
        "quietMs": 600,
        "timeoutMs": 15000
      },
      {
        "action": "type",
        "text": "\r"
      },
      {
        "action": "delay",
        "ms": 20000
      },
      {
        "action": "waitStable",
        "quietMs": 1500,
        "timeoutMs": 20000
      },
      {
        "action": "snapshot",
        "name": "after-prompt"
      },
      {
        "action": "type",
        "text": "\u0004"
      },
      {
        "action": "waitStable",
        "quietMs": 500,
        "timeoutMs": 10000
      }
    ],
    "snapshots": [
      "after-prompt"
    ]
  },
  "responses": [
    {
      "file": "fixtures/sse/openai/big-text-usage.sse",
      "chunkByEvent": true
    }
  ]
}