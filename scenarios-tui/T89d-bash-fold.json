{
  "id": "T89d-bash-fold",
  "description": "落盘后 `!seq 1 60` 折叠预览",
  "provider": "openai-completions",
  "model": "mock-model",
  "mode": "print",
  "prompt": "hi",
  "tui": {
    "cols": 100,
    "rows": 30,
    "snapshots": [
      "after-bash"
    ],
    "steps": [
      {
        "action": "waitScreen",
        "contains": "Pi can explain",
        "timeoutMs": 30000
      },
      {
        "action": "waitStable",
        "quietMs": 1200,
        "timeoutMs": 25000
      },
      {
        "action": "type",
        "text": "hi\r"
      },
      {
        "action": "delay",
        "ms": 8000
      },
      {
        "action": "waitStable",
        "quietMs": 1500,
        "timeoutMs": 20000
      },
      {
        "action": "type",
        "text": "!seq 1 60\r"
      },
      {
        "action": "waitStable",
        "quietMs": 1500,
        "timeoutMs": 20000
      },
      {
        "action": "delay",
        "ms": 800
      },
      {
        "action": "snapshot",
        "name": "after-bash"
      },
      {
        "action": "type",
        "text": "\u0004"
      },
      {
        "action": "waitExit",
        "timeoutMs": 20000
      }
    ]
  },
  "responses": [
    {
      "file": "fixtures/sse/openai/text-basic.sse"
    }
  ]
}
