      {
        "action": "type",
        "text": "\u000e"
      },
      {
        "action": "delay",
        "ms": 1000
      },
      {
        "action": "waitStable",
        "quietMs": 1200,
        "timeoutMs": 20000
      },
      {
        "action": "snapshot",
        "name": "named"
