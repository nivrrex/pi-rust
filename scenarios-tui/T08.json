{
  "id": "T08",
  "description": "P7-4d W4：TUI 两轮对话（mock 两步回复）——重点验证**第二轮请求体包含第一轮的 user+assistant**（会话层与请求层对拍）",
  "provider": "openai-completions",
  "model": "mock-model",
  "mode": "print",
  "prompt": "say hi",
  "responses": [
    {
      "file": "fixtures/sse/openai/turn-a.sse"
    },
    {
      "file": "fixtures/sse/openai/turn-b.sse"
    }
  ],
  "files": {
    "AGENTS.md": "# 项目规则\n\n- 项目级：改代码前先跑测试。\n"
  },
  "globalFiles": {
    "CLAUDE.md": "# 全局规则\n\n- 全局级：回答用中文。\n"
  },
  "tui": {
    "cols": 100,
    "rows": 30,
    "steps": [
      {
        "action": "waitScreen",
        "contains": "Pi can explain",
        "timeoutMs": 25000
      },
      {
        "action": "type",
        "text": "say hi"
      },
      {
        "action": "waitStable",
        "quietMs": 600,
        "timeoutMs": 15000
      },
      {
        "action": "type",
        "text": "\r"
      },
      {
        "action": "waitStrip",
        "contains": "第一轮回复",
        "timeoutMs": 30000
      },
      {
        "action": "waitStable",
        "quietMs": 2000,
        "timeoutMs": 20000
      },
      {
        "action": "type",
        "text": "again"
      },
      {
        "action": "waitStable",
        "quietMs": 600,
        "timeoutMs": 15000
      },
      {
        "action": "type",
        "text": "\r"
      },
      {
        "action": "waitStrip",
        "contains": "第二轮回复",
        "timeoutMs": 30000
      },
      {
        "action": "waitStable",
        "quietMs": 2000,
        "timeoutMs": 20000
      },
      {
        "action": "snapshot",
        "name": "after-second"
      },
      {
        "action": "type",
        "text": "\u0004"
      },
      {
        "action": "waitStable",
        "quietMs": 500,
        "timeoutMs": 10000
      }
    ],
    "snapshots": [
      "after-second"
    ]
  }
}
