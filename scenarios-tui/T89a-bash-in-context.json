{
  "provider": "openai-completions",
  "model": "mock-model",
  "mode": "print",
  "prompt": "hi",
  "tui": {
    "cols": 100,
    "rows": 30,
    "steps": [
      {
        "action": "waitScreen",
        "contains": "Pi can explain",
        "timeoutMs": 30000
      },
      {
        "action": "waitStable",
        "quietMs": 1200,
        "timeoutMs": 25000
      },
      {
        "action": "type",
        "text": "hi\r"
      },
      {
        "action": "delay",
        "ms": 8000
      },
      {
        "action": "waitStable",
        "quietMs": 1500,
        "timeoutMs": 20000
      },
      {
        "action": "type",
        "text": "!echo AAA\r"
      },
      {
        "action": "waitStable",
        "quietMs": 1500,
        "timeoutMs": 20000
      },
      {
        "action": "delay",
        "ms": 800
      },
      {
        "action": "snapshot",
        "name": "after-bash"
      },
      {
        "action": "type",
        "text": "\u0004"
      },
      {
        "action": "waitExit",
        "timeoutMs": 20000
      }
    ],
    "snapshots": [
      "after-bash"
    ]
  },
  "responses": [
    {
      "file": "fixtures/sse/openai/text-basic.sse"
    }
  ],
  "id": "T89a-bash-in-context",
  "description": "落盘后 `!echo AAA`"
}
